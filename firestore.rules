rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // info@xabi.world & info@jamaldrenthe.com are full administrators across all environments
    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == 'info@xabi.world' ||
        request.auth.token.email == 'info@jamaldrenthe.com' ||
        request.auth.token.get('admin', false) == true ||
        ('admin' in request.auth.token && request.auth.token.admin == true)
      );
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Administrators have full read and write access across all collections
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Normal authenticated users can manage their own profile and sub-collections
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      match /{subCollection=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Card management rules for Xabi World
    match /cards/{cardId} {
      // Admins can read, create, update, delete any card
      // Authenticated users can read, update their own cards where request.auth.uid == resource.data.userId or request.auth.token.email == resource.data.userEmail
      allow read, update: if isAdmin() || (
        signedIn() && (
          ('userId' in resource.data && request.auth.uid == resource.data.userId) ||
          ('userEmail' in resource.data && request.auth.token.email == resource.data.userEmail) ||
          (resource.data.get('userId', '') == request.auth.uid) ||
          (request.auth.token.email != null && resource.data.get('userEmail', '') == request.auth.token.email)
        )
      );

      // Authenticated users can create cards where request.auth.uid == request.resource.data.userId or request.auth.token.email == request.resource.data.userEmail
      allow create: if isAdmin() || (
        signedIn() && (
          ('userId' in request.resource.data && request.auth.uid == request.resource.data.userId) ||
          ('userEmail' in request.resource.data && request.auth.token.email == request.resource.data.userEmail) ||
          (request.resource.data.get('userId', '') == request.auth.uid) ||
          (request.auth.token.email != null && request.resource.data.get('userEmail', '') == request.auth.token.email)
        )
      );

      // Admins can delete any card
      allow delete: if isAdmin();
    }
  }
}
